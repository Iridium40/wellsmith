# Copy to .env and fill in real values. Never commit .env.

VITE_PUBLIC_BUILDER_KEY=
PING_MESSAGE=

# Resend Email Service
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Sender address for all outgoing mail.
NEWSLETTER_FROM_EMAIL=

# Fallback recipient for health assessment submissions when ADMIN_EMAIL is
# unset. Not used for newsletter signups — those send no internal alert.
NEWSLETTER_TO_EMAIL=

# Where health assessment submissions are sent.
# Falls back to NEWSLETTER_TO_EMAIL when unset.
ADMIN_EMAIL=

# Cloudflare Turnstile (bot protection on the newsletter form).
# Site key is public and must keep the VITE_ prefix to reach the browser.
# Secret key is server-only — never prefix it with VITE_.
# Until TURNSTILE_SECRET_KEY is set, verification is skipped and the form
# is unprotected.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
